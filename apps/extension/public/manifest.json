{
  "manifest_version": 3,
  "name": "KIRA",
  "version": "1.1.0",
  "description": "Capture to KIRA.",
  "permissions": ["activeTab", "contextMenus", "clipboardWrite", "scripting", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1:47653/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KIRA"
  },
  "commands": {
    "save-hovered-image": {
      "suggested_key": { "default": "Alt+Shift+K" },
      "description": "Save the image under the cursor to KIRA"
    },
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Save this page to KIRA"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
