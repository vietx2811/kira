{
  "name": "@kira/desktop",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:tauri": "pnpm build && pnpm --filter @kira/extension build && xcodebuild -project \"../extension/safari/KIRA Safari/KIRA Safari.xcodeproj\" -scheme \"KIRA Safari\" -configuration Release -derivedDataPath \"../extension/safari/DerivedData\" CODE_SIGNING_ALLOWED=NO build",
    "release:mac": "tauri build && ../../packaging/macos/sign-kira.sh src-tauri/target/release/bundle/macos/KIRA.app",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri"
  },
