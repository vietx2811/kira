{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KIRA",
  "version": "1.0.1",
  "identifier": "vxstudio.kira",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build:tauri",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "KIRA",
        "width": 1280,
        "height": 820,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "shadow": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": [
      "binaries/kira-vision-ocr-helper",
      "binaries/kira-foundation-models-helper",
      "binaries/kira-natural-language-helper",
      "binaries/kira-codex-helper",
      "binaries/codex"
    ],
    "resources": {
      "../../extension/dist": "extension/dist"
    },
    "macOS": {
      "bundleVersion": "2",
      "files": {
        "PlugIns/KIRA Safari Extension.appex": "../../extension/safari/DerivedData/Build/Products/Release/KIRA Safari Extension.appex"
      }
    },
    "icon": ["icons/icon.icns"]
  }
}
